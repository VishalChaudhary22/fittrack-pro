# Kaaya Fit — environment template
# Copy to .env and fill in real values. Never commit .env.

# Supabase (required — the app's backend)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Email — no client keys. The feedback form posts to the send-feedback
# Edge Function, and the weekly digest is sent by send-weekly-email;
# both mail through Resend with RESEND_API_KEY held only in Supabase
# Edge Function secrets. (EmailJS was removed — see PR history.)

# Web Push (VAPID) — the public key pairs with the VAPID_PRIVATE_KEY held
# only in Supabase Edge Function secrets.
VITE_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
