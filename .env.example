# Kaaya Fit — environment template
# Copy to .env and fill in real values. Never commit .env.

# Supabase (required — the app's backend)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# EmailJS — contact/feedback form
# Note: the public key is designed to be client-visible, but treat all
# three as secrets-in-repo and rotate them if .env was ever published.
VITE_EMAILJS_SERVICE_ID=YOUR_EMAILJS_SERVICE_ID
VITE_EMAILJS_TEMPLATE_ID=YOUR_EMAILJS_TEMPLATE_ID
VITE_EMAILJS_PUBLIC_KEY=YOUR_EMAILJS_PUBLIC_KEY

# Web Push (VAPID) — the public key pairs with the VAPID_PRIVATE_KEY held
# only in Supabase Edge Function secrets.
VITE_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
